{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "sonolii-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-03",
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "sonolii-media"
    }
  ],
  "observability": {
    "enabled": true
  }
}
