{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "sonolii-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-03",
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "sonolii-media"
    }
  ],
  "triggers": {
    "crons": [
      "0 3 * * *"
    ]
  },
  "observability": {
    "enabled": true
  },
  "ratelimits": [
    {
      "name": "FEEDBACK_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}
